# --- Obsidian Headless ---
OBSIDIAN_EMAIL=
OBSIDIAN_PASSWORD=
OBSIDIAN_VAULT_NAME=
# Optional end-to-end encryption password for Obsidian Sync vaults.
OBSIDIAN_VAULT_ENCRYPTION_PASSWORD=
OBSIDIAN_VAULT_PATH=/vault

# Set to "false" to disable starting the Obsidian Headless sync process
# (useful for local development where you populate the vault manually).
OBSIDIAN_HEADLESS_ENABLED=true

# --- API ---
API_TOKEN=change-me
API_HOST=0.0.0.0
API_PORT=8000

# --- Embeddings ---
# Provider: "openai" or "fake" (deterministic, offline; intended for tests)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Storage ---
# Vector backend: "qdrant" or "memory"
VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=obsidian_notes
SQLITE_PATH=/data/obsidian-rag-api.sqlite

# --- Indexing ---
CHUNK_TARGET_TOKENS=750
CHUNK_MAX_TOKENS=1000
CHUNK_MIN_TOKENS=100
WATCHER_ENABLED=true

# --- Logging ---
LOG_LEVEL=info
